{
  "name": "scrimba-clone",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "extension",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "build": "bun build:shared && bun build:backend && bun build:extension",
    "build:shared": "cd backend && bun run tsc -b --force ../packages/shared",
    "build:backend": "cd backend && bun run tsc -b",
    "build:extension": "cd extension && bun run compile && bun run package",
    "reset:backend": "bash scripts/reset-backend.sh",
    "reset:extension": "bash scripts/reset-extension.sh",
    "dev:backend": "cd backend && bun run --watch src/index.ts",
    "postinstall": "cd backend && bun x prisma generate"
  },
  "devDependencies": {
    "jsonwebtoken": "^9.0.3",
    "node-gyp": "^11.4.2"
  },
  "dependencies": {
    "ccusage": "^20.0.20"
  }
}

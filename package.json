{
  "name": "scrimba-clone",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "extension",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "build": "bun build:backend && bun build:extension",
    "build:backend": "cd backend && bun run tsc -b",
    "build:extension": "cd extension && bun run tsc -b",
    "dev:backend": "cd backend && bun run --watch src/index.ts",
    "postinstall": "cd backend && bun x prisma generate"
  },
  "devDependencies": {
    "jsonwebtoken": "^9.0.3"
  },
  "dependencies": {
    "ccusage": "^20.0.20"
  }
}

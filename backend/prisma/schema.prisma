datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique
  username      String    @unique
  password_hash String
  role          String    @default("student") // 'student' | 'teacher' | 'admin'
  created_at    DateTime  @default(now()) @db.Timestamptz

  courses       Course[]  @relation("AuthoredCourses")
  enrollments   Enrollment[]
  progress      Progress[]

  @@map("users")
}

model Course {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  author_id   String    @db.Uuid
  author      User      @relation("AuthoredCourses", fields: [author_id], references: [id])
  title       String
  description String?
  tags        String[]
  level       String?   // 'beginner' | 'intermediate' | 'advanced'
  published   Boolean   @default(false)
  created_at  DateTime  @default(now()) @db.Timestamptz

  lessons     Lesson[]
  enrollments Enrollment[]

  @@map("courses")
}

model Lesson {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id     String    @db.Uuid
  course        Course    @relation(fields: [course_id], references: [id], onDelete: Cascade)
  order_index   Int
  title         String
  duration_ms   Int?
  has_challenge Boolean   @default(false)
  published     Boolean   @default(false)
  scrim_key     String?   // R2 object key for lesson.scrim
  video_key     String?   // R2 object key for video.mp4
  timecodes_key String?   // R2 object key for timecodes.json
  created_at    DateTime  @default(now()) @db.Timestamptz

  progress      Progress[]

  @@map("lessons")
}

model Enrollment {
  user_id     String    @db.Uuid
  course_id   String    @db.Uuid
  user        User      @relation(fields: [user_id], references: [id])
  course      Course    @relation(fields: [course_id], references: [id])
  enrolled_at DateTime  @default(now()) @db.Timestamptz

  @@id([user_id, course_id])
  @@map("enrollments")
}

model Progress {
  user_id      String    @db.Uuid
  lesson_id    String    @db.Uuid
  user         User      @relation(fields: [user_id], references: [id])
  lesson       Lesson    @relation(fields: [lesson_id], references: [id])
  completed    Boolean   @default(false)
  completed_at DateTime? @db.Timestamptz

  @@id([user_id, lesson_id])
  @@map("progress")
}

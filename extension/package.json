{
  "name": "scrimba-clone",
  "displayName": "Scrimba Clone",
  "description": "Interactive coding lessons in VS Code",
  "version": "1.0.0",
  "publisher": "scrimba",
  "icon": "media/scrim-icon.svg",
  "categories": ["Education", "Other"],
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onView:scrim.catalog",
    "onView:scrim.myCourses",
    "onView:scrim.myLearning",
    "onView:scrim.myForks"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "package": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node"
  },
  "contributes": {
    "commands": [
      {
        "command": "scrim.newCourse",
        "title": "Scrim: New Course",
        "icon": "$(add)"
      },
      {
        "command": "scrim.renameCourse",
        "title": "Scrim: Rename Course",
        "icon": "$(edit)"
      },
      {
        "command": "scrim.deleteCourse",
        "title": "Scrim: Delete Course",
        "icon": "$(trash)"
      },
      {
        "command": "scrim.newLesson",
        "title": "Scrim: New Lesson",
        "icon": "$(add)"
      },
      {
        "command": "scrim.renameLesson",
        "title": "Scrim: Rename Lesson",
        "icon": "$(edit)"
      },
      {
        "command": "scrim.deleteLesson",
        "title": "Scrim: Delete Lesson",
        "icon": "$(trash)"
      },
      {
        "command": "scrim.startRecording",
        "title": "Scrim: Start Recording",
        "icon": "$(record)"
      },
      {
        "command": "scrim.stopRecording",
        "title": "Scrim: Stop Recording",
        "icon": "$(stop)"
      },
      {
        "command": "scrim.markChapter",
        "title": "Scrim: Mark Chapter Here"
      },
      {
        "command": "scrim.addChallenge",
        "title": "Scrim: Add Challenge Here"
      },
      {
        "command": "scrim.previewLesson",
        "title": "Scrim: Play Recorded Lesson",
        "icon": "$(play)"
      },
      {
        "command": "scrim.publishLesson",
        "title": "Scrim: Publish Lesson",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "scrim.enroll",
        "title": "Scrim: Enroll",
        "icon": "$(add)"
      },
      {
        "command": "scrim.fork",
        "title": "Scrim: Fork Here"
      },
      {
        "command": "scrim.togglePlayPause",
        "title": "Scrim: Toggle Play/Pause"
      },
      {
        "command": "scrim.resume",
        "title": "Scrim: Resume"
      },
      {
        "command": "scrim.register",
        "title": "Scrim: Register"
      },
      {
        "command": "scrim.login",
        "title": "Scrim: Login"
      },
      {
        "command": "scrim.logout",
        "title": "Scrim: Logout"
      },
      {
        "command": "scrim.editCourseMetadata",
        "title": "Scrim: Edit Course Details",
        "icon": "$(gear)"
      },
      {
        "command": "scrim.moveLessonUp",
        "title": "Scrim: Move Lesson Up",
        "icon": "$(arrow-up)"
      },
      {
        "command": "scrim.moveLessonDown",
        "title": "Scrim: Move Lesson Down",
        "icon": "$(arrow-down)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "scrim.newCourse",
          "when": "view == scrim.myCourses",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "scrim.enroll",
          "when": "view == scrim.catalog && viewItem == course",
          "group": "inline"
        },
        {
          "command": "scrim.newLesson",
          "when": "view == scrim.myCourses && viewItem == course",
          "group": "inline"
        },
        {
          "command": "scrim.renameCourse",
          "when": "view == scrim.myCourses && viewItem == course",
          "group": "1_modification"
        },
        {
          "command": "scrim.editCourseMetadata",
          "when": "view == scrim.myCourses && viewItem == course",
          "group": "1_modification"
        },
        {
          "command": "scrim.deleteCourse",
          "when": "view == scrim.myCourses && viewItem == course",
          "group": "1_modification"
        },
        {
          "command": "scrim.startRecording",
          "when": "view == scrim.myCourses && viewItem == lesson",
          "group": "inline"
        },
        {
          "command": "scrim.previewLesson",
          "when": "view == scrim.myCourses && viewItem == lesson",
          "group": "inline"
        },
        {
          "command": "scrim.publishLesson",
          "when": "view == scrim.myCourses && viewItem == lesson",
          "group": "inline"
        },
        {
          "command": "scrim.moveLessonUp",
          "when": "view == scrim.myCourses && viewItem == lesson",
          "group": "inline"
        },
        {
          "command": "scrim.moveLessonDown",
          "when": "view == scrim.myCourses && viewItem == lesson",
          "group": "inline"
        },
        {
          "command": "scrim.renameLesson",
          "when": "view == scrim.myCourses && viewItem == lesson",
          "group": "1_modification"
        },
        {
          "command": "scrim.deleteLesson",
          "when": "view == scrim.myCourses && viewItem == lesson",
          "group": "1_modification"
        }
      ],
      "editor/title": [
        {
          "command": "scrim.stopRecording",
          "when": "scrim.isRecording",
          "group": "navigation"
        },
        {
          "command": "scrim.markChapter",
          "when": "scrim.isRecording",
          "group": "navigation"
        },
        {
          "command": "scrim.addChallenge",
          "when": "scrim.isRecording",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "scrim.startRecording",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r"
      },
      {
        "command": "scrim.stopRecording",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "scrim.isRecording"
      },
      {
        "command": "scrim.markChapter",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "scrim.isRecording"
      },
      {
        "command": "scrim.addChallenge",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "scrim.isRecording"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "scrim-sidebar",
          "title": "Scrim",
          "icon": "media/scrim-icon.svg"
        }
      ]
    },
    "views": {
      "scrim-sidebar": [
        {
          "id": "scrim.catalog",
          "name": "Course Catalog",
          "type": "tree"
        },
        {
          "id": "scrim.myLearning",
          "name": "My Learning",
          "type": "tree"
        },
        {
          "id": "scrim.myCourses",
          "name": "My Courses (Teacher)",
          "type": "tree"
        },
        {
          "id": "scrim.myForks",
          "name": "My Forks",
          "type": "tree"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "scrim.myCourses",
        "contents": "No courses yet.\n[Create Your First Course](command:scrim.newCourse)\n\nYou need to be logged in to create courses.\n[Login](command:scrim.login) or [Register](command:scrim.register)"
      }
    ],
    "configuration": {
      "title": "Scrim",
      "properties": {
        "scrim.apiUrl": {
          "type": "string",
          "default": "http://localhost:4000",
          "description": "Backend API URL for Scrim"
        }
      }
    }
  },
  "dependencies": {
    "@scrimba-clone/shared": "workspace:*",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.0.0"
  }
}

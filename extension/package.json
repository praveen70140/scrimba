{
  "name": "extension",
  "version": "1.0.0",
  "publisher": "scrimba-clone",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "scrim.newCourse",
        "title": "Scrim: New Course",
        "icon": "$(add)"
      },
      {
        "command": "scrim.newLesson",
        "title": "Scrim: New Lesson",
        "icon": "$(add)"
      },
      {
        "command": "scrim.startRecording",
        "title": "Scrim: Start Recording",
        "icon": "$(record)"
      },
      {
        "command": "scrim.stopRecording",
        "title": "Scrim: Stop Recording",
        "icon": "$(stop)"
      },
      {
        "command": "scrim.openLessonWorkspace",
        "title": "Scrim: Open Lesson Workspace",
        "icon": "$(edit)"
      },
      {
        "command": "scrim.markChapter",
        "title": "Scrim: Mark Chapter Here"
      },
      {
        "command": "scrim.addChallenge",
        "title": "Scrim: Add Challenge Here"
      },
      {
        "command": "scrim.previewLesson",
        "title": "Scrim: Play Recorded Lesson",
        "icon": "$(play)"
      },
      {
        "command": "scrim.publishLesson",
        "title": "Scrim: Publish Lesson",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "scrim.fork",
        "title": "Scrim: Fork Here"
      },
      {
        "command": "scrim.togglePlayPause",
        "title": "Scrim: Toggle Play/Pause"
      },
      {
        "command": "scrim.resume",
        "title": "Scrim: Resume"
      },
      {
        "command": "scrim.register",
        "title": "Scrim: Register"
      },
      {
        "command": "scrim.login",
        "title": "Scrim: Login"
      },
      {
        "command": "scrim.logout",
        "title": "Scrim: Logout"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "scrim.newCourse",
          "when": "view == scrim.myCourses",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "scrim.newLesson",
          "when": "view == scrim.myCourses && viewItem == course",
          "group": "inline"
        },
        {
          "command": "scrim.openLessonWorkspace",
          "when": "view == scrim.myCourses && viewItem == lesson",
          "group": "inline"
        },
        {
          "command": "scrim.startRecording",
          "when": "view == scrim.myCourses && viewItem == lesson",
          "group": "inline"
        },
        {
          "command": "scrim.previewLesson",
          "when": "view == scrim.myCourses && viewItem == lesson",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "scrim-sidebar",
          "title": "Scrim",
          "icon": "media/scrim-icon.svg"
        }
      ]
    },
    "views": {
      "scrim-sidebar": [
        { "id": "scrim.catalog", "name": "Course Catalog", "type": "tree" },
        { "id": "scrim.myCourses", "name": "My Courses", "type": "tree" },
        { "id": "scrim.myForks", "name": "My Forks", "type": "tree" }
      ]
    }
  },
  "dependencies": {
    "@scrimba-clone/shared": "workspace:*",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0"
  }
}

# Docker service credentials — NOT committed to git
# Copy this file to .env.docker and fill in your values

POSTGRES_USER=scrimba
POSTGRES_PASSWORD=scrimba_password
POSTGRES_DB=scrimba_clone

RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfs_password

# S3 client credentials for the backend; keep these in sync with RustFS above
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfs_password
